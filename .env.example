# Copy this file to `.env` and fill in your key, then restart `npm run dev`.
#
# Google Photorealistic 3D Tiles (the "3D" button on the map):
#   1. console.cloud.google.com → create/select a project
#   2. APIs & Services → Library → enable "Map Tiles API"
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. Restrict the key: API restrictions → Map Tiles API only, and
#      Website restrictions → your kiosk/dev origins (e.g. http://localhost:5173)
#   5. Paste it below. Requires billing enabled on the Google project.
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox engine (recommended — smoothest, cinematic day/dusk/night lighting):
#   1. account.mapbox.com → Access tokens → Create a token (pk....)
#   2. Add URL restrictions to it — the Default public token cannot be
#      restricted, which is why that option looks missing on it.
#   3. Paste it below and restart `npm run dev`.
# With a token set, the app boots on Mapbox Standard (vector 3D, dusk lighting).
# Without one, it uses the keyless MapLibre engine.
VITE_MAPBOX_TOKEN=

# Access gate for the deployed site (Vercel only — not used by `npm run dev`).
# Any long random string. With it set, the site answers 404 unless the browser
# has been through /?k=<this value> once. Leave it empty and the site is open.
SITE_KEY=
